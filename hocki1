}

// ===== FIREBASE =====
function initFirebase() {
  if (!FIREBASE_DB_URL) return;
  try {
    const cleanUrl = FIREBASE_DB_URL.replace(/\/$/, "");
    if (!firebase.apps.length) firebase.initializeApp({ databaseURL: cleanUrl });
    firebaseDb = firebase.database();
    firebaseDb.ref('.info/connected').on('value', snap => {
      isConnected = !!snap.val();
      const dot = document.getElementById('syncDot');
      const txt = document.getElementById('syncText');
      if (dot) dot.className = "w-2 h-2 rounded-full " + (isConnected ? "bg-emerald-400" : "bg-amber-400");
      if (txt) txt.textContent = isConnected ? "Realtime Online" : "Offline";
    });
    firebaseDb.ref(FB_DATA_KEY).on('value', snapshot => {
      const d = snapshot.val();
      if (!d) return;
      if (d.students) students = d.students;
      if (d.officers) officers = d.officers;
      if (d.rules) rules = d.rules;
      if (d.scores) scores = d.scores;
      if (d.baobaiList) baobaiList = d.baobaiList;
      if (d.taiLieuList) taiLieuList = d.taiLieuList;
      if (d.tkbData) tkbData = d.tkbData;
      if (d.messages) messages = d.messages;
      if (d.activityLog) activityLog = d.activityLog;
      if (d.seatingMap) seatingMap = d.seatingMap;
      cleanOldLogs();
      saveStorage(false);
      refreshAllViews();
    });
  } catch (e) { console.error("Firebase init error:", e); }
}

function cleanExpiredBaobai() {
  const today = new Date().toISOString().slice(0, 10);
  const before = baobaiList.length;
  baobaiList = baobaiList.filter(b => b.deadline >= today);
  if (baobaiList.length !== before) saveStorage(true);
}

async function saveStorage(syncToCloud = true) {
  cleanOldLogs();
  localStorage.setItem(STORAGE_PREFIX + 'students', JSON.stringify(students));
  localStorage.setItem(STORAGE_PREFIX + 'officers', JSON.stringify(officers));
  localStorage.setItem(STORAGE_PREFIX + 'rules', JSON.stringify(rules));
  localStorage.setItem(STORAGE_PREFIX + 'scores', JSON.stringify(scores));
  localStorage.setItem(STORAGE_PREFIX + 'baobai', JSON.stringify(baobaiList));
  localStorage.setItem(STORAGE_PREFIX + 'tailieu', JSON.stringify(taiLieuList));
  localStorage.setItem(STORAGE_PREFIX + 'tkb', JSON.stringify(tkbData));
  localStorage.setItem(STORAGE_PREFIX + 'messages', JSON.stringify(messages));
  localStorage.setItem(STORAGE_PREFIX + 'activityLog', JSON.stringify(activityLog));
  localStorage.setItem(STORAGE_PREFIX + 'seating', JSON.stringify(seatingMap));
  if (syncToCloud && firebaseDb) {
    try {
      await firebaseDb.ref(FB_DATA_KEY).set({
        students, officers, rules, scores, baobaiList, taiLieuList, tkbData, messages, activityLog, seatingMap, updatedAt: Date.now()
      });
    } catch (err) { console.warn("Firebase write error:", err); }
  }
}

