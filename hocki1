<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Lớp 7A1 - THCS Chu Văn An</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap');
    body { font-family: 'Be Vietnam Pro', sans-serif; -webkit-tap-highlight-color: transparent; }
    .custom-scroll::-webkit-scrollbar { width: 4px; height: 4px; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 pb-20 md:pb-8">

  <!-- Header -->
  <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-3 py-2.5 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center font-bold text-lg shadow-inner">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <h1 class="text-base font-bold leading-tight">LỚP 7A1</h1>
          <p class="text-[11px] text-indigo-200" id="headerWeekText">THCS Chu Văn An - Đức Lập, Lâm Đồng</p>
        </div>
      </div>
      <div id="userBadge" class="hidden flex items-center gap-2">
        <div id="syncStatusBadge" class="flex items-center gap-1.5 text-[11px] bg-white/10 px-2 py-1 rounded-lg">
          <span id="syncDot" class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span id="syncText" class="hidden sm:inline text-indigo-100 font-medium">Đang kết nối...</span>
        </div>
        <button onclick="openChangePinModal()" title="Đổi mật khẩu" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold flex items-center gap-1 transition">
          <i class="fa-solid fa-key"></i> <span class="hidden sm:inline">Đổi PIN</span>
        </button>
        <button onclick="logout()" title="Đăng xuất" class="p-2 rounded-lg bg-red-500/80 hover:bg-red-600 text-xs font-semibold flex items-center gap-1 transition">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Navigation -->
  <nav id="mainNav" class="hidden fixed bottom-0 left-0 right-0 md:static md:top-[53px] bg-white border-t md:border-b md:border-t-0 shadow-lg md:shadow-sm z-40">
    <div class="max-w-7xl mx-auto px-2 md:px-4 flex justify-around md:justify-start gap-1 md:gap-2 py-1.5 md:py-2 text-xs font-semibold">
      <button onclick="switchTab('tab-phuhuynh')" id="btn-tab-phuhuynh" class="tab-btn flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-house-user text-base md:text-sm"></i><span>Tổng quan con</span>
      </button>
      <button onclick="switchTab('tab-baobai')" id="btn-tab-baobai" class="tab-btn hidden flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-book-open text-base md:text-sm"></i><span>Sổ báo bài</span>
      </button>
      <button onclick="switchTab('tab-tkb')" id="btn-tab-tkb" class="tab-btn flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-calendar-days text-base md:text-sm"></i><span>Thời khoá biểu</span>
      </button>
      <button onclick="switchTab('tab-nendep')" id="btn-tab-nendep" class="tab-btn flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-ranking-star text-base md:text-sm"></i><span>Thi đua cả lớp</span>
      </button>
      <button onclick="switchTab('tab-sodo')" id="btn-tab-sodo" class="tab-btn flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-border-all text-base md:text-sm"></i><span>Sơ đồ lớp</span>
      </button>
      <button onclick="switchTab('tab-tinnhan')" id="btn-tab-tinnhan" class="tab-btn relative flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-comments text-base md:text-sm"></i>
        <span id="tabTinNhanLabel">Nhắn tin GVCN</span>
        <span id="unreadBadge" class="hidden absolute top-1 right-2 w-2 h-2 rounded-full bg-red-500"></span>
      </button>
      <button onclick="switchTab('tab-cauhinh')" id="btn-tab-cauhinh" class="tab-btn hidden flex-1 md:flex-initial py-2 px-3 rounded-xl flex flex-col md:flex-row items-center justify-center gap-1 text-slate-500 hover:text-indigo-600 transition">
        <i class="fa-solid fa-sliders text-base md:text-sm"></i><span>Cấu hình GVCN</span>
      </button>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto p-3 md:p-6">
    <!-- LOGIN -->
    <div id="loginScreen" class="max-w-md mx-auto mt-4 md:mt-10 bg-white p-5 md:p-7 rounded-2xl shadow-xl border border-slate-200">
      <div class="text-center mb-5">
        <span class="inline-block p-3.5 rounded-2xl bg-indigo-50 text-indigo-600 text-3xl mb-2"><i class="fa-solid fa-shield-halved"></i></span>
        <h2 class="text-lg md:text-xl font-bold text-slate-800">Cổng Thông Tin Lớp 7A1</h2>
        <p class="text-xs text-slate-500 mt-0.5">THCS Chu Văn An - Xã Đức Lập - Lâm Đồng</p>
        <p class="text-[11px] text-slate-400 mt-1">Sổ Báo Bài • Nề Nếp • Đồng Bộ Realtime</p>
      </div>
      <div class="flex p-1 bg-slate-100 rounded-xl mb-5">
        <button type="button" onclick="setRoleTab('phuhuynh')" id="tabPhBtn" class="flex-1 py-2 text-xs font-bold rounded-lg bg-white shadow-sm text-indigo-600">Phụ huynh / Học sinh</button>
        <button type="button" onclick="setRoleTab('canbo')" id="tabCbBtn" class="flex-1 py-2 text-xs font-bold rounded-lg text-slate-500 hover:text-slate-800">Cán bộ lớp / GVCN</button>
      </div>
      <form id="formPhuhuynh" onsubmit="loginPh(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Chọn tên học sinh:</label>
          <select id="loginHsSelect" required class="w-full p-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 text-sm bg-white"></select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Mật khẩu:</label>
          <input type="password" id="loginHsPin" required placeholder="Nhập mật khẩu..." class="w-full p-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 text-sm">
        </div>
        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm shadow transition">
          <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i> Đăng nhập hệ thống
        </button>
      </form>
      <form id="formCanbo" onsubmit="loginCb(event)" class="space-y-4 hidden">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Vị trí / Chức danh:</label>
          <select id="loginCbRole" required class="w-full p-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 text-sm bg-white">
            <option value="gvcn">Giáo viên chủ nhiệm (GVCN)</option>
            <option value="loptruong">Lớp trưởng</option>
            <option value="loppho">Lớp phó</option>
            <option value="totruong1">Tổ trưởng Tổ 1</option>
            <option value="totruong2">Tổ trưởng Tổ 2</option>
            <option value="totruong3">Tổ trưởng Tổ 3</option>
            <option value="totruong4">Tổ trưởng Tổ 4</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Mã PIN cán sự:</label>
          <input type="password" id="loginCbPin" required placeholder="Nhập mã PIN xác thực..." class="w-full p-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 text-sm">
        </div>
        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm shadow transition">
          <i class="fa-solid fa-shield-halved mr-1"></i> Đăng nhập hệ thống
        </button>
      </form>
    </div>

    <!-- APP SCREEN -->
    <div id="appScreen" class="hidden space-y-4">
      <div class="bg-white p-3.5 md:p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-base">
            <i id="userIconDisplay" class="fa-solid fa-user"></i>
          </div>
          <div>
            <div id="userNameDisplay" class="font-bold text-sm md:text-base text-slate-800"></div>
            <div id="userRoleDisplay" class="text-[11px] text-slate-500"></div>
          </div>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-100 hidden sm:inline-block" id="bannerLiveWeekBadge">Tuần ...</span>
          <button onclick="openChangePinModal()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-2.5 py-1.5 rounded-lg transition flex items-center gap-1">
            <i class="fa-solid fa-key text-amber-500"></i> Đổi PIN
          </button>
        </div>
      </div>

      <!-- TAB PHỤ HUYNH -->
      <div id="tab-phuhuynh" class="tab-content space-y-4">
        <div class="bg-gradient-to-br from-indigo-700 via-indigo-800 to-slate-900 text-white p-4 md:p-5 rounded-2xl shadow-lg space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-2.5">
            <div>
              <span class="text-[11px] font-semibold text-indigo-200 uppercase tracking-wider">Thông Tin Thi Đua Của Con</span>
              <h3 class="text-base md:text-lg font-bold" id="phChildFullName">Học sinh: ...</h3>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold bg-white/20 px-2.5 py-1 rounded-full backdrop-blur-sm" id="phCurrentWeekRangeLabel">Tuần ...</span>
            </div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-center pt-1">
            <div class="bg-white/10 backdrop-blur-sm p-2.5 rounded-xl border border-white/10">
              <div class="text-[10px] text-indigo-200 font-medium">Hạng tuần này</div>
              <div id="phCardRank" class="text-lg md:text-xl font-extrabold text-amber-300 mt-0.5">Top --</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm p-2.5 rounded-xl border border-white/10">
              <div class="text-[10px] text-indigo-200 font-medium">Tổng điểm tuần</div>
              <div id="phCardScore" class="text-lg md:text-xl font-extrabold text-white mt-0.5">100đ</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm p-2.5 rounded-xl border border-white/10">
              <div class="text-[10px] text-indigo-200 font-medium">Điểm cộng</div>
              <div id="phCardPlus" class="text-lg md:text-xl font-extrabold text-emerald-300 mt-0.5">+0</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm p-2.5 rounded-xl border border-white/10">
              <div class="text-[10px] text-indigo-200 font-medium">Điểm trừ</div>
              <div id="phCardMinus" class="text-lg md:text-xl font-extrabold text-rose-300 mt-0.5">-0</div>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between border-b pb-2">
              <h4 class="font-bold text-xs md:text-sm text-slate-800 flex items-center gap-1.5">
                <i class="fa-solid fa-book-open text-indigo-600"></i> Báo Bài Còn Hạn
              </h4>
              <span class="text-[10px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200 font-medium">Gần hạn lên đầu</span>
            </div>
            <div id="homeBaobaiList" class="space-y-2.5 max-h-96 overflow-y-auto custom-scroll pr-1"></div>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between border-b pb-2">
              <h4 class="font-bold text-xs md:text-sm text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-indigo-600"></i> Nhật Ký Nề Nếp Tuần Này
              </h4>
              <span class="text-[11px] text-slate-400 font-medium">Thứ 2 - Thứ 7</span>
            </div>
            <div id="homeViolationList" class="space-y-2 max-h-96 overflow-y-auto custom-scroll pr-1"></div>
          </div>
        </div>
        <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-lg"><i class="fa-solid fa-paper-plane"></i></div>
            <div>
              <h5 class="text-xs md:text-sm font-bold text-slate-800">Cần liên hệ hoặc giải trình với GVCN?</h5>
              <p class="text-[11px] text-slate-500">Gửi tin nhắn xin phép nghỉ học, giải trình hoặc trao đổi học tập</p>
            </div>
          </div>
          <button onclick="switchTab('tab-tinnhan')" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow transition">Nhắn tin GVCN ngay</button>
        </div>
      </div>

      <!-- TAB BÁO BÀI -->
      <div id="tab-baobai" class="tab-content hidden space-y-4">
        <div class="flex items-center justify-between bg-white p-4 rounded-2xl border shadow-sm">
          <div>
            <h3 class="font-bold text-slate-800 text-base flex items-center gap-2"><i class="fa-solid fa-book-bookmark text-indigo-600"></i> Quản Lý Sổ Báo Bài</h3>
            <p class="text-xs text-slate-500">Xếp theo hạn nộp gần nhất • Quá hạn tự động xoá</p>
          </div>
          <button id="btnAddBaobaiTab" onclick="openBaobaiModal()" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow flex items-center gap-1.5 transition">
            <i class="fa-solid fa-plus"></i> Đăng báo bài
          </button>
        </div>
        <div id="officerBaobaiContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div>

        <!-- TÀI LIỆU TẢI VỀ -->
        <div class="bg-white p-4 rounded-2xl border shadow-sm space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b pb-2">
            <div>
              <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2"><i class="fa-solid fa-file-arrow-down text-indigo-600"></i> Tài Liệu Học Tập</h3>
              <p class="text-[11px] text-slate-500">Đề cương, đề ôn, tài liệu tham khảo – học sinh tải về</p>
            </div>
            <button id="btnAddTailieu" onclick="openTailieuModal()" class="hidden px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow flex items-center gap-1">
              <i class="fa-solid fa-plus"></i> Thêm tài liệu
            </button>
          </div>
          <div id="tailieuListContainer" class="space-y-2 max-h-80 overflow-y-auto custom-scroll"></div>
        </div>
      </div>

      <!-- TAB TKB -->
      <div id="tab-tkb" class="tab-content hidden space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-3.5 md:p-4 rounded-2xl border shadow-sm">
          <div>
            <h3 class="font-bold text-slate-800 text-sm md:text-base flex items-center gap-1.5"><i class="fa-solid fa-calendar-days text-indigo-600"></i> Thời Khoá Biểu Lớp 7A1</h3>
            <p class="text-[11px] text-slate-500">Từ Thứ 2 đến Thứ 6</p>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex bg-slate-100 p-1 rounded-xl text-xs font-bold">
              <button onclick="setTkbSession('morning')" id="btnTkbMorning" class="px-3 py-1.5 rounded-lg bg-white shadow-sm text-indigo-700">Buổi Sáng</button>
              <button onclick="setTkbSession('afternoon')" id="btnTkbAfternoon" class="px-3 py-1.5 rounded-lg text-slate-600">Buổi Chiều</button>
            </div>
            <button id="btnEditTkb" onclick="openTkbConfigModal()" class="hidden px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow flex items-center gap-1 transition">
              <i class="fa-solid fa-pen-to-square"></i> Cập nhật TKB
            </button>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-center text-xs md:text-sm border-collapse" id="tkbTable">
              <thead class="bg-indigo-50 text-indigo-900 font-bold border-b">
                <tr>
                  <th class="p-2.5 md:p-3 border-r w-16">Tiết</th>
                  <th class="p-2.5 md:p-3 border-r">Thứ Hai</th>
                  <th class="p-2.5 md:p-3 border-r">Thứ Ba</th>
                  <th class="p-2.5 md:p-3 border-r">Thứ Tư</th>
                  <th class="p-2.5 md:p-3 border-r">Thứ Năm</th>
                  <th class="p-2.5 md:p-3">Thứ Sáu</th>
                </tr>
              </thead>
              <tbody id="tkbBody" class="divide-y text-slate-700"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB THI ĐUA -->
      <div id="tab-nendep" class="tab-content hidden space-y-4">
        <div class="bg-white p-3.5 md:p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="font-bold text-xs text-slate-500 whitespace-nowrap"><i class="fa-solid fa-calendar-week mr-1"></i>Tuần (Thứ 2 - Thứ 7):</span>
            <select id="selectWeek" onchange="onWeekDropdownChanged()" class="p-2 border rounded-xl text-xs md:text-sm font-bold text-indigo-700 bg-indigo-50 border-indigo-200 max-w-[280px] sm:max-w-none"></select>
          </div>
          <div class="flex items-center gap-2">
            <select id="filterGroupSelect" onchange="renderScoreboard()" class="p-2 border rounded-xl text-xs font-semibold bg-white">
              <option value="all">Toàn bộ 4 tổ</option>
              <option value="Tổ 1">Tổ 1</option>
              <option value="Tổ 2">Tổ 2</option>
              <option value="Tổ 3">Tổ 3</option>
              <option value="Tổ 4">Tổ 4</option>
            </select>
            <button id="btnOpenRecordModal" onclick="openRecordModal()" class="hidden px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow flex items-center gap-1 transition">
              <i class="fa-solid fa-plus-circle"></i> Chấm điểm
            </button>
          </div>
        </div>
        <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
          <div class="px-4 py-3 border-b bg-slate-50 flex items-center justify-between">
            <h3 class="font-bold text-xs md:text-sm text-slate-700 flex items-center gap-1.5">
              <i class="fa-solid fa-ranking-star text-indigo-600"></i> Bảng Xếp Hạng Thi Đua <span id="currentWeekTitle" class="text-indigo-600">Tuần ...</span>
            </h3>
            <span class="text-[11px] text-slate-400 font-medium">Khởi điểm 100đ</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs md:text-sm">
              <thead class="bg-slate-100 text-slate-600 text-[11px] uppercase font-bold border-b">
                <tr>
                  <th class="py-2.5 px-2 text-center w-14">Hạng</th>
                  <th class="py-2.5 px-3">Họ và tên</th>
                  <th class="py-2.5 px-2 text-center w-16">Tổ</th>
                  <th class="py-2.5 px-2 text-center w-20">Điểm</th>
                  <th class="py-2.5 px-2 text-center w-20">Loại</th>
                  <th class="py-2.5 px-3">Chi tiết ghi nhận tuần</th>
                </tr>
              </thead>
              <tbody id="studentScoreTable" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB SƠ ĐỒ LỚP -->
      <div id="tab-sodo" class="tab-content hidden space-y-4">
        <div class="bg-white p-3.5 md:p-4 rounded-2xl border shadow-sm flex flex-wrap items-center justify-between gap-3">
