  const text = input.value.trim();
  if (!text) return;
  const now = new Date();
  const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')} - ${String(now.getDate()).padStart(2,'0')}/${String(now.getMonth()+1).padStart(2,'0')}`;
  messages.unshift({
    id: Date.now(),
    studentId: currentUser.student.id,
    studentName: currentUser.student.name,
    group: currentUser.student.group,
    content: text,
    time: timeStr,
    replies: []
  });
  logActivity('Gửi tin nhắn GVCN', text.slice(0, 60) + (text.length > 60 ? '…' : ''));
  await saveStorage(true);
  input.value = '';
  renderMessages();
  alert("Đã gửi tin nhắn đến Giáo viên chủ nhiệm thành công!");
}

