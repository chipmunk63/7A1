// ===== LỊCH SỬ THAO TÁC (chỉ GVCN xem, tự xóa sau 14 ngày) =====
const LOG_RETENTION_MS = 14 * 24 * 60 * 60 * 1000; // 14 ngày

function cleanOldLogs() {
  const cutoff = Date.now() - LOG_RETENTION_MS;
  const before = activityLog.length;
  activityLog = activityLog.filter(l => l.ts >= cutoff);
  return activityLog.length !== before;
}

function logActivity(action, detail = '') {
  if (!currentUser) return;
  const entry = {
    id: Date.now() + Math.random().toString(36).slice(2, 6),
    ts: Date.now(),
    userId: currentUser.type === 'ph' ? currentUser.student.id : currentUser.officer.id,
    userName: currentUser.type === 'ph' ? ('PH: ' + currentUser.student.name) : currentUser.officer.name,
    role: currentUser.type === 'ph' ? 'phuhuynh' : (currentUser.officer.role === 'totruong' ? 'totruong' : currentUser.officer.role),
    action,
    detail
  };
  activityLog.unshift(entry);
  cleanOldLogs();
}

function formatLogTime(ts) {
  const d = new Date(ts);
  return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}

function renderActivityLog() {
  if (!currentUser || currentUser.type !== 'officer' || currentUser.officer.role !== 'gvcn') return;
  cleanOldLogs();
  const filter = document.getElementById('logFilterRole')?.value || 'all';
  let list = activityLog;
  if (filter !== 'all') {
    list = activityLog.filter(l => l.role === filter || (filter === 'totruong' && l.role === 'totruong'));
  }
  const countEl = document.getElementById('activityLogCount');
  if (countEl) countEl.textContent = `Hiển thị ${list.length} / ${activityLog.length} bản ghi (giữ tối đa 14 ngày)`;
  const container = document.getElementById('activityLogList');
  if (!container) return;
  if (list.length === 0) {
    container.innerHTML = '<div class="p-6 text-center text-slate-400 italic text-xs bg-slate-50 rounded-xl border">Chưa có lịch sử thao tác nào.</div>';
    return;
  }
  const roleColor = {
    gvcn: 'bg-indigo-100 text-indigo-800',
    loptruong: 'bg-amber-100 text-amber-800',
    loppho: 'bg-sky-100 text-sky-800',
    totruong: 'bg-emerald-100 text-emerald-800',
    phuhuynh: 'bg-slate-100 text-slate-700'
  };
  container.innerHTML = list.map(l => `
    <div class="flex items-start gap-2 p-2.5 rounded-xl border border-slate-100 bg-slate-50/70 text-xs hover:bg-slate-50 transition">
      <div class="shrink-0 w-16 text-[10px] text-slate-400 font-mono pt-0.5">${formatLogTime(l.ts)}</div>
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-1.5 mb-0.5">
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold ${roleColor[l.role] || 'bg-slate-100 text-slate-600'}">${l.userName}</span>
          <span class="font-semibold text-slate-800">${l.action}</span>
        </div>
        ${l.detail ? `<p class="text-[11px] text-slate-500 truncate" title="${l.detail}">${l.detail}</p>` : ''}
      </div>
    </div>`).join('');
}

async function clearAllActivityLog() {
  if (!confirm('Xoá toàn bộ lịch sử thao tác? Hành động này không thể hoàn tác.')) return;
  activityLog = [];
  await saveStorage(true);
  renderActivityLog();
