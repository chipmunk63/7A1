// ===== PHỤ HUYNH OVERVIEW =====
function renderPhOverview() {
  if (!currentUser || currentUser.type !== 'ph') return;
  const st = currentUser.student;
  const weekRecords = scores.filter(sc => sc.studentId === st.id && sc.week === selectedWeek);
  const plusTotal = weekRecords.filter(r => r.type === 'plus').reduce((s, r) => s + r.points, 0);
  const minusTotal = weekRecords.filter(r => r.type === 'minus').reduce((s, r) => s + r.points, 0);
  const finalScore = 100 + plusTotal - minusTotal;

  const allComputed = students.map(s => {
    const recs = scores.filter(sc => sc.studentId === s.id && sc.week === selectedWeek);
    const p = recs.filter(r => r.type === 'plus').reduce((a, r) => a + r.points, 0);
    const m = recs.filter(r => r.type === 'minus').reduce((a, r) => a + r.points, 0);
    return { id: s.id, score: 100 + p - m };
  }).sort((a, b) => b.score - a.score);

  let rank = 1;
  for (let i = 0; i < allComputed.length; i++) {
    if (i > 0 && allComputed[i].score < allComputed[i - 1].score) rank = i + 1;
    if (allComputed[i].id === st.id) break;
  }

  document.getElementById('phCardRank').textContent = `Top ${rank} / ${students.length}`;
  document.getElementById('phCardScore').textContent = `${finalScore}đ`;
  document.getElementById('phCardPlus').textContent = `+${plusTotal}`;
  document.getElementById('phCardMinus').textContent = `-${minusTotal}`;

  const vList = document.getElementById('homeViolationList');
  if (weekRecords.length === 0) {
    vList.innerHTML = '<div class="p-5 text-center text-slate-400 italic text-xs bg-slate-50 rounded-xl border">Tuần này em thực hiện nề nếp rất tốt, không có vi phạm nào.</div>';
  } else {
    vList.innerHTML = weekRecords.map(r => {
      const isPlus = r.type === 'plus';
      return `<div class="p-2.5 rounded-xl border flex items-center justify-between text-xs ${isPlus ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-rose-50 text-rose-800 border-rose-200'}">
        <div class="flex items-center gap-2"><i class="fa-solid ${isPlus ? 'fa-circle-check text-emerald-500' : 'fa-circle-exclamation text-rose-500'}"></i><span class="font-semibold">${r.reason}</span></div>
        <div class="text-right"><span class="font-bold">${isPlus ? '+' : '-'}${r.points}đ</span><span class="text-[10px] text-slate-400 block">${r.date}</span></div>
      </div>`;
    }).join('');
  }
  renderBaobaiHome();
}

