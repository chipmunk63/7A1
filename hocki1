async function submitChangePin(e) {
  e.preventDefault();
  const oldPin = document.getElementById('oldPinInput').value.trim();
  const newPin = document.getElementById('newPinInput').value.trim();
  const confirmPin = document.getElementById('confirmPinInput').value.trim();
  if (newPin.length < 4) return alert("Mật khẩu mới phải có ít nhất 4 ký tự!");
  if (newPin !== confirmPin) return alert("Xác nhận mật khẩu mới không khớp!");

  if (currentUser.type === 'ph') {
    if (currentUser.student.pin !== oldPin) return alert("Mật khẩu hiện tại không đúng!");
    const idx = students.findIndex(s => s.id === currentUser.student.id);
    if (idx !== -1) {
      students[idx].pin = newPin;
      currentUser.student.pin = newPin;
      logActivity('Đổi mật khẩu', 'Phụ huynh đổi PIN');
      await saveStorage(true);
      closeChangePinModal();
      alert("Phụ huynh đổi mật khẩu thành công!");
    }
  } else {
    const offKey = currentUser.officer.id;
    if (officers[offKey].pin !== oldPin) return alert("Mã PIN hiện tại không chính xác!");
    officers[offKey].pin = newPin;
    currentUser.officer.pin = newPin;
    logActivity('Đổi PIN cán sự', currentUser.officer.name);
    await saveStorage(true);
    closeChangePinModal();
    alert("Đã cập nhật mã PIN mới thành công!");
  }
}

