// ===== THI ĐUA =====
function renderScoreboard() {
  const groupFilter = document.getElementById('filterGroupSelect').value;
  const computed = students.map(st => {
    const weekRecords = scores.filter(sc => sc.studentId === st.id && sc.week === selectedWeek);
    const plusTotal = weekRecords.filter(r => r.type === 'plus').reduce((s, r) => s + r.points, 0);
    const minusTotal = weekRecords.filter(r => r.type === 'minus').reduce((s, r) => s + r.points, 0);
    return { student: st, plusTotal, minusTotal, finalScore: 100 + plusTotal - minusTotal, records: weekRecords };
  }).sort((a, b) => b.finalScore - a.finalScore);

  let curRank = 1;
  computed.forEach((item, i) => {
    if (i > 0 && item.finalScore < computed[i - 1].finalScore) curRank = i + 1;
    item.rank = curRank;
  });

  let displayList = groupFilter === 'all' ? computed : computed.filter(it => it.student.group === groupFilter);
  const tbody = document.getElementById('studentScoreTable');
  tbody.innerHTML = displayList.map(item => {
    const st = item.student;
    const isChild = currentUser?.type === 'ph' && currentUser.student.id === st.id;
    const isOfficer = currentUser?.type === 'officer';
    let rankBadge = item.finalScore >= 90 ? '<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800">Tốt</span>'
      : item.finalScore >= 80 ? '<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-800">Khá</span>'
      : '<span class="px-2 py-0.5 rounded text-[11px] font-bold bg-red-100 text-red-800">Cố gắng</span>';
    let rankDisplay = item.rank === 1 ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300"><i class="fa-solid fa-trophy text-amber-500"></i> 1</span>`
      : item.rank === 2 ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-700">2</span>`
      : item.rank === 3 ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-orange-100 text-orange-800">3</span>`
      : `<span class="text-xs font-bold text-slate-500">#${item.rank}</span>`;

    let detailHtml = '';
    if (isOfficer || isChild) {
      if (item.records.length) {
        detailHtml = item.records.map(r => {
          const color = r.type === 'plus' ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-rose-700 bg-rose-50 border-rose-200';
          let actions = '';
          if (isOfficer) {
            const off = currentUser.officer;
            const canEdit = off.role === 'gvcn' || off.role === 'loptruong' || off.role === 'loppho' || (off.role === 'totruong' && off.group === st.group);
            if (canEdit) {
              actions = `<span class="inline-flex items-center gap-1 ml-1.5 pl-1.5 border-l border-slate-300">
                <button onclick="openEditRecordModal(${r.id})" title="Sửa" class="hover:text-amber-600 p-0.5"><i class="fa-solid fa-pen text-[10px]"></i></button>
                <button onclick="deleteScoreRecord(${r.id})" title="Xoá" class="hover:text-red-600 p-0.5"><i class="fa-solid fa-xmark text-[11px]"></i></button>
              </span>`;
            }
          }
          return `<span class="inline-flex items-center text-[10px] px-2 py-0.5 mr-1 mb-1 border rounded-lg ${color}"><span>${r.type === 'plus' ? '+' : '-'}${r.points}đ: ${r.reason}</span>${actions}</span>`;
        }).join('');
      } else detailHtml = '<span class="text-[11px] text-slate-400 italic">Không vi phạm</span>';
    } else detailHtml = '<span class="text-[11px] text-slate-400 italic"><i class="fa-solid fa-lock text-[10px] mr-1"></i>Bảo mật riêng tư</span>';

    return `<tr class="${isChild ? 'bg-amber-50/80 font-semibold border-l-4 border-l-amber-500' : 'hover:bg-slate-50'}">
      <td class="py-2.5 px-2 text-center">${rankDisplay}</td>
      <td class="py-2.5 px-3 font-medium text-slate-800">${st.name}${isChild ? ' <span class="text-[10px] bg-indigo-600 text-white px-1.5 py-0.5 rounded-full font-bold ml-1">Con</span>' : ''}</td>
      <td class="py-2.5 px-2 text-center text-xs text-slate-500">${st.group}</td>
      <td class="py-2.5 px-2 text-center font-bold text-xs md:text-sm ${item.finalScore >= 90 ? 'text-indigo-600' : item.finalScore >= 80 ? 'text-amber-600' : 'text-red-600'}">${item.finalScore}</td>
      <td class="py-2.5 px-2 text-center">${rankBadge}</td>
      <td class="py-2.5 px-3">${detailHtml}</td>
    </tr>`;
  }).join('');
}

