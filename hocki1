// ===== SƠ ĐỒ LỚP (KÉO THẢ CHỖ NGỒI) =====
const GROUP_COLORS = {
  'Tổ 1': { bg: 'bg-green-100', border: 'border-green-400', text: 'text-green-900', badge: 'bg-green-500' },
  'Tổ 2': { bg: 'bg-orange-100', border: 'border-orange-400', text: 'text-orange-900', badge: 'bg-orange-500' },
  'Tổ 3': { bg: 'bg-sky-100', border: 'border-sky-400', text: 'text-sky-900', badge: 'bg-sky-500' },
  'Tổ 4': { bg: 'bg-pink-100', border: 'border-pink-400', text: 'text-pink-900', badge: 'bg-pink-500' }
};

function ensureSeatingMap() {
  if (!seatingMap || !Array.isArray(seatingMap) || seatingMap.length !== SEAT_COUNT) {
    seatingMap = buildDefaultSeating();
  }
  const validIds = new Set(students.map(s => s.id));
  seatingMap = seatingMap.map(id => (id && validIds.has(id) ? id : null));
  const seated = new Set(seatingMap.filter(Boolean));
  const missing = students.filter(s => !seated.has(s.id));
  for (const st of missing) {
    const emptyIdx = seatingMap.findIndex(id => id === null);
    if (emptyIdx >= 0) seatingMap[emptyIdx] = st.id;
  }
}

function buildDefaultSeating() {
  // Xếp lần lượt theo tổ vào 48 chỗ (6 hàng × 8 cột)
  const map = Array(SEAT_COUNT).fill(null);
  const ordered = [];
  ['Tổ 1', 'Tổ 2', 'Tổ 3', 'Tổ 4'].forEach(g => {
    students.filter(s => s.group === g).forEach(s => ordered.push(s.id));
  });
  // HS không thuộc 4 tổ (nếu có)
  students.forEach(s => { if (!ordered.includes(s.id)) ordered.push(s.id); });
  ordered.forEach((id, i) => { if (i < SEAT_COUNT) map[i] = id; });
  return map;
}

function shortName(fullName) {
  if (!fullName) return '';
  const parts = fullName.trim().split(/\s+/);
  if (parts.length <= 2) return fullName;
  return parts[parts.length - 2] + ' ' + parts[parts.length - 1];
}

function renderSeatCell(idx, isGvcn) {
  const sid = seatingMap[idx];
  const st = sid ? students.find(s => s.id === sid) : null;
  const seatNum = idx + 1;
  const base = 'seat-cell flex-1 min-w-[48px] sm:min-w-[58px] max-w-[80px] rounded-lg p-1 sm:p-1.5 text-center relative transition border-2';

  if (st) {
    const stIdx = students.findIndex(s => s.id === st.id);
    const col = GROUP_COLORS[st.group] || { bg: 'bg-slate-100', border: 'border-slate-300', text: 'text-slate-800', badge: 'bg-slate-400' };
    const isChild = currentUser?.type === 'ph' && currentUser.student.id === st.id;
    const editBtn = isGvcn
      ? `<button type="button" onclick="event.stopPropagation();editStudentNameFromSeat('${st.id}')" title="Sửa tên" class="absolute -top-1.5 -right-1.5 w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-amber-400 hover:bg-amber-500 text-white text-[8px] flex items-center justify-center shadow z-10"><i class="fa-solid fa-pen"></i></button>`
      : '';
    return `<div class="${base} ${col.bg} ${col.border}
      ${isGvcn ? 'cursor-grab active:cursor-grabbing hover:ring-2 hover:ring-indigo-400' : ''}
      ${isChild ? 'ring-2 ring-amber-400' : ''}"
      data-seat="${idx}"
      ${isGvcn ? `draggable="true" ondragstart="onSeatDragStart(event,${idx})" ondragend="onSeatDragEnd(event)"` : ''}
      ondragover="onSeatDragOver(event)" ondrop="onSeatDrop(event,${idx})">
      <div class="absolute -top-1.5 -left-1.5 w-4 h-4 sm:w-5 sm:h-5 rounded-full ${col.badge} text-white text-[8px] sm:text-[9px] font-bold flex items-center justify-center shadow">${seatNum}</div>
      ${editBtn}
      <div class="text-[9px] sm:text-[10px] font-bold ${col.text} leading-tight mt-1 line-clamp-2" title="${st.name}">${shortName(st.name)}</div>
      <div class="text-[8px] text-slate-400 mt-0.5 hidden sm:block">${st.group.replace('Tổ ','T')}</div>
    </div>`;
  }
  return `<div class="${base} bg-slate-50 border-dashed border-slate-200
    ${isGvcn ? 'hover:border-indigo-300 hover:bg-indigo-50/50' : ''}"
    data-seat="${idx}" ondragover="onSeatDragOver(event)" ondrop="onSeatDrop(event,${idx})">
    <div class="absolute -top-1.5 -left-1.5 w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-slate-300 text-white text-[8px] sm:text-[9px] font-bold flex items-center justify-center">${seatNum}</div>
    <div class="text-[9px] text-slate-300 mt-2 italic">Trống</div>
  </div>`;
}

async function editStudentNameFromSeat(studentId) {
  if (!(currentUser?.type === 'officer' && currentUser.officer.role === 'gvcn')) return;
  const idx = students.findIndex(s => s.id === studentId);
  if (idx < 0) return;
  await editStudentName(idx);
}

function renderSeatingChart() {
  ensureSeatingMap();
  const grid = document.getElementById('seatingGrid');
  if (!grid) return;

  const isGvcn = currentUser?.type === 'officer' && currentUser.officer.role === 'gvcn';
  const hint = document.getElementById('sodoEditHint');
  const btnReset = document.getElementById('btnResetSeating');
  const btnSave = document.getElementById('btnSaveSeating');
  if (hint) hint.classList.toggle('hidden', !isGvcn);
  if (btnReset) btnReset.classList.toggle('hidden', !isGvcn);
  if (btnSave) btnSave.classList.toggle('hidden', !isGvcn);

  const aisleHtml = `<div class="w-4 sm:w-8 md:w-12 shrink-0 flex flex-col items-center justify-center">
      <div class="w-full h-full min-h-[36px] border-l-2 border-r-2 border-dashed border-slate-300 bg-slate-100/70 rounded flex items-center justify-center">
        <span class="text-[7px] sm:text-[8px] text-slate-400 font-medium hidden sm:inline" style="writing-mode:vertical-rl;transform:rotate(180deg)">Lối đi</span>
      </div>
    </div>`;

  let html = '';
  for (let r = 0; r < SEAT_ROWS; r++) {
    html += `<div class="flex items-stretch gap-1 sm:gap-1.5 mb-1.5 sm:mb-2">`;
    html += `<div class="w-6 sm:w-8 shrink-0 flex items-center justify-center">
      <span class="text-[9px] sm:text-[10px] font-bold text-slate-400">H${r + 1}</span>
    </div>`;
    // 2 chỗ trái
    for (let c = 0; c < 2; c++) html += renderSeatCell(r * SEAT_COLS + c, isGvcn);
    html += aisleHtml;
    // 4 chỗ giữa
    for (let c = 2; c < 6; c++) html += renderSeatCell(r * SEAT_COLS + c, isGvcn);
    html += aisleHtml;
    // 2 chỗ phải
    for (let c = 6; c < 8; c++) html += renderSeatCell(r * SEAT_COLS + c, isGvcn);
    html += `</div>`;
  }
  grid.innerHTML = html;
}

function onSeatDragStart(e, idx) {
  if (!(currentUser?.type === 'officer' && currentUser.officer.role === 'gvcn')) {
    e.preventDefault();
    return;
  }
  dragSeatIndex = idx;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', String(idx));
  e.currentTarget.classList.add('opacity-50');
}

function onSeatDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
}

function onSeatDrop(e, targetIdx) {
  e.preventDefault();
  if (!(currentUser?.type === 'officer' && currentUser.officer.role === 'gvcn')) return;
  const fromIdx = dragSeatIndex !== null ? dragSeatIndex : parseInt(e.dataTransfer.getData('text/plain'));
  if (isNaN(fromIdx) || fromIdx === targetIdx) return;
  // Đổi chỗ
  const tmp = seatingMap[fromIdx];
  seatingMap[fromIdx] = seatingMap[targetIdx];
  seatingMap[targetIdx] = tmp;
  dragSeatIndex = null;
  renderSeatingChart();
}

function onSeatDragEnd(e) {
  e.currentTarget.classList.remove('opacity-50');
  dragSeatIndex = null;
}

async function saveSeatingLayout() {
  ensureSeatingMap();
  logActivity('Lưu sơ đồ lớp', `Đã cập nhật vị trí chỗ ngồi`);
  await saveStorage(true);
  alert('Đã lưu sơ đồ lớp thành công!');
}

async function resetSeatingToDefault() {
  if (!confirm('Xếp lại chỗ ngồi theo tổ (Tổ 1 → hàng 1, Tổ 2 → hàng 2…)? Vị trí hiện tại sẽ bị ghi đè.')) return;
  seatingMap = buildDefaultSeating();
  logActivity('Xếp lại sơ đồ lớp', 'Theo tổ mặc định');
  await saveStorage(true);
  renderSeatingChart();
  alert('Đã xếp lại sơ đồ theo tổ!');
}
</script>
