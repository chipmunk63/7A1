    } else {
      dlBtn = `<span class="text-[11px] text-slate-400 italic">Chưa có file/link</span>`;
    }
    return `<div class="flex flex-wrap items-center justify-between gap-2 p-3 rounded-xl border border-slate-200 bg-slate-50/80">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-800">${tl.subject || 'Chung'}</span>
          <span class="font-bold text-xs text-slate-800">${tl.title}</span>
        </div>
        ${tl.desc ? `<p class="text-[11px] text-slate-500 mt-0.5">${tl.desc}</p>` : ''}
        <p class="text-[10px] text-slate-400 mt-0.5">Đăng bởi: ${tl.author || 'Cán sự'} · ${tl.date || ''}</p>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        ${dlBtn}
        ${canDelete ? `<button onclick="deleteTailieu(${tl.id})" class="px-2 py-1.5 text-red-500 hover:bg-red-50 rounded-lg text-xs"><i class="fa-solid fa-trash-can"></i></button>` : ''}
      </div>
    </div>`;
  }).join('');
}

async function saveTailieu(e) {
  e.preventDefault();
  const title = document.getElementById('tlTitle').value.trim();
  const subject = document.getElementById('tlSubject').value;
  const desc = document.getElementById('tlDesc').value.trim();
  const url = document.getElementById('tlUrl').value.trim();
  const fileInput = document.getElementById('tlFile');
  const file = fileInput.files && fileInput.files[0];

  if (!title) return alert('Vui lòng nhập tên tài liệu!');
  if (!url && !file) return alert('Cần có link tải về hoặc chọn file!');

  const now = new Date();
  const dateStr = `${String(now.getDate()).padStart(2,'0')}/${String(now.getMonth()+1).padStart(2,'0')}/${now.getFullYear()}`;
  const entry = {
    id: Date.now(),
    title,
    subject,
    desc,
    url: url || '',
    fileData: null,
    fileName: null,
    author: currentUser.officer ? currentUser.officer.name : 'Cán sự',
    date: dateStr
  };

  if (file) {
    if (file.size > 1.5 * 1024 * 1024) {
      return alert('File quá lớn (> 1.5MB). Hãy upload lên Google Drive và dán link thay thế.');
    }
    try {
      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
      entry.fileData = dataUrl;
      entry.fileName = file.name;
    } catch (err) {
      return alert('Không đọc được file. Thử dùng link Drive.');
    }
  }

  taiLieuList.unshift(entry);
  logActivity('Thêm tài liệu', `${title} (${subject})`);
  await saveStorage(true);
  closeTailieuModal();
  renderTailieuList();
  alert('Đã thêm tài liệu thành công!');
}

async function deleteTailieu(id) {
  if (!confirm('Xoá tài liệu này?')) return;
  const tl = taiLieuList.find(t => t.id === id);
  taiLieuList = taiLieuList.filter(t => t.id !== id);
  logActivity('Xoá tài liệu', tl ? tl.title : '');
  await saveStorage(true);
  renderTailieuList();
}

