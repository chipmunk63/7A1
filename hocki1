      dlBtn = `<a href="${tl.url}" target="_blank" rel="noopener" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-[11px] font-bold rounded-lg inline-flex items-center gap-1"><i class="fa-solid fa-download"></i> Tải / Mở link</a>`;
