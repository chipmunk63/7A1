function forceSyncWithCloud() {
  if (!firebaseDb) return alert("Chưa kết nối Firebase!");
  firebaseDb.ref(FB_DATA_KEY).once('value').then(snap => {
    const d = snap.val();
    if (!d) return alert("Không có dữ liệu trên cloud.");
    if (d.students) students = d.students;
    if (d.officers) officers = d.officers;
    if (d.rules) rules = d.rules;
    if (d.scores) scores = d.scores;
    if (d.baobaiList) baobaiList = d.baobaiList;
    if (d.taiLieuList) taiLieuList = d.taiLieuList;
    if (d.tkbData) tkbData = d.tkbData;
    if (d.messages) messages = d.messages;
    if (d.activityLog) activityLog = d.activityLog;
    if (d.seatingMap) seatingMap = d.seatingMap;
    cleanOldLogs();
    saveStorage(false);
    refreshAllViews();
    alert("Đã đồng bộ thành công từ Realtime Database!");
  });
}

