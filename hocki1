  logActivity('Sửa tên học sinh', `${oldName} → ${students[idx].name}`);
  await saveStorage(true);
  renderGvcnConfig();
  renderScoreboard();
  renderSeatingChart();
  refreshStudentLoginDropdown();
  if (currentUser?.type === 'ph' && currentUser.student.id === st.id) {
    currentUser.student.name = students[idx].name;
    document.getElementById('userNameDisplay').textContent = 'Phụ huynh em: ' + students[idx].name;
    document.getElementById('phChildFullName').textContent = `Em: ${students[idx].name} (${st.group})`;
  }
  alert(`Đã đổi tên: "${oldName}" → "${students[idx].name}"`);
}

